{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qari",
  "main": "edge/previewWorker.ts",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/p/*"],
  },
}
